{

	"schemaVersion": 1,

	"id": "harmony", "version": "${version}",
    "license": "GNU Lesser General Public License version 3 (LGPLv3)",

    "name": "Harmony", "icon": "assets/harmony/icon.png",
	"description": "It's a mod library. It tries to make modding more easy and comfy.",
	"authors": ["Engine_Machiner"],

	"contact": {
        "homepage": "https://modrinth.com/mod/harmonylib",
		"issues": "https://github.com/EngineMachiner/Harmony/issues",
		"sources": "https://github.com/EngineMachiner/Harmony"
	},

	"environment": "*",
    "depends": {

        "java": ">=17",
        "minecraft": "~${minecraft_version}",

        "fabric-api": "*",
        "fabricloader": ">=${fabric_loader}",
        "fabric-language-kotlin": ">=${fabric_kotlin_version}"

    },

    "entrypoints": { "main": ["com.enginemachiner.harmony.Initializer"] },
    "mixins": ["harmony.mixins.json"]

}